# Copy this file to .env and fill in the values. .env is gitignored — never commit it.

# Circle Console -> https://console.circle.com/api-keys
# Optional: ArcShield only reads market data, which works without a key.
# A key raises the rate limit, which matters when demoing or deploying publicly.
VITE_CIRCLE_KIT_KEY=

# Arc testnet RPC. The public endpoint works; override to use a provider.
VITE_ARC_RPC_URL=https://rpc.testnet.arc.io

# Deployer key for the demo vault. Use a throwaway wallet, never one holding
# real assets. Fund it with test USDC from https://faucet.circle.com (Arc Testnet)
# — on Arc gas is paid in USDC, not ETH.
DEPLOYER_PRIVATE_KEY=
